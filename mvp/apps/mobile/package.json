{
  "name": "@pol/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-secure-store": "~57.0.4",
    "expo-font": "~57.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android": "expo run:android",
    "start": "expo start",
    "build": "expo export --platform android --output-dir ./dist",
    "qa:functional": "node scripts/mobile_functional_qa.mjs",
    "qa:regression": "node scripts/mobile_regression_qa.mjs",
    "build:apk": "node scripts/build_android_variant.mjs",
    "build:apk:retailer": "node scripts/build_android_variant.mjs retailer",
    "build:apk:vendor": "node scripts/build_android_variant.mjs vendor",
    "build:aab:retailer": "node scripts/build_android_variant.mjs retailer aab",
    "build:aab:vendor": "node scripts/build_android_variant.mjs vendor aab",
    "analyze:bundle": "node scripts/analyze_bundle.mjs",
    "qa:pre-apk": "node scripts/pre_apk_qa.mjs",
    "qa:live": "node scripts/live_api_preflight.mjs",
    "qa:mock": "node --experimental-strip-types scripts/mock_transport_qa.ts"
  },
  "private": true
}
