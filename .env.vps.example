# Copy to .env on the VPS. Never commit real credentials.

# Initial VPS verification uses staging until a real HTTPS domain is attached.
ENVIRONMENT=staging

# PostgreSQL 18
POL_DB_USER=pol_app
POL_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Application authentication
POL_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES

# Same-origin web/API routing through Nginx.
NEXT_PUBLIC_API_BASE_URL=
POL_CORS_ORIGINS=http://85.198.50.29

# S3-compatible object storage (Arvan/S3/etc.)
POL_S3_ENDPOINT_URL=
POL_S3_ACCESS_KEY_ID=
POL_S3_SECRET_ACCESS_KEY=
POL_S3_REGION=us-east-1
POL_S3_BUCKET=pol-media

# Transactional SMS provider
POL_SMS_PROVIDER=SMSIR
POL_SMS_ENDPOINT=
POL_SMS_TOKEN=

# Optional push provider
POL_PUSH_PROVIDER=GENERIC_PUSH
POL_PUSH_ENDPOINT=
POL_PUSH_TOKEN=

# Worker tuning
POL_WORKER_INTERVAL_SECONDS=5
POL_WORKER_BATCH_SIZE=50
