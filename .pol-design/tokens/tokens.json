{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "POL Precision Commerce Tokens",
  "version": "2.0.0",
  "authority": "Document 56 (POL-DESIGN-VISUAL-001 v2.0.0)",
  "color": {
    "light": {
      "bg.canvas": "#F7F9FC",
      "surface.default": "#FFFFFF",
      "surface.subtle": "#F1F5F9",
      "surface.elevated": "#FFFFFF",
      "border.subtle": "#E2E8F0",
      "border.strong": "#CBD5E1",
      "text.primary": "#0F172A",
      "text.secondary": "#475569",
      "text.muted": "#64748B",
      "text.disabled": "#94A3B8",
      "brand.primary": "#2563EB",
      "brand.hover": "#1D4ED8",
      "brand.active": "#1E40AF",
      "brand.accent": "#4F46E5",
      "semantic.success": "#15803D",
      "semantic.warning": "#B45309",
      "semantic.danger": "#B91C1C",
      "semantic.info": "#1D4ED8",
      "focus.ring": "#2563EB"
    },
    "night": {
      "bg.canvas": "#0F141C",
      "surface.default": "#151C27",
      "surface.subtle": "#1B2431",
      "surface.elevated": "#202A38",
      "border.subtle": "#2A3646",
      "border.strong": "#3A4A5F",
      "text.primary": "#F8FAFC",
      "text.secondary": "#CBD5E1",
      "text.muted": "#94A3B8",
      "text.disabled": "#64748B",
      "brand.primary": "#60A5FA",
      "brand.hover": "#93C5FD",
      "brand.active": "#3B82F6",
      "brand.accent": "#818CF8",
      "semantic.success": "#4ADE80",
      "semantic.warning": "#FBBF24",
      "semantic.danger": "#F87171",
      "semantic.info": "#60A5FA",
      "focus.ring": "#93C5FD"
    }
  },
  "typeScale": {
    "displayXl": { "size": 32, "lineHeight": 40, "weight": 700 },
    "displayL": { "size": 28, "lineHeight": 36, "weight": 700 },
    "h1": { "size": 24, "lineHeight": 32, "weight": 700 },
    "h2": { "size": 20, "lineHeight": 28, "weight": 600 },
    "h3": { "size": 18, "lineHeight": 26, "weight": 600 },
    "title": { "size": 16, "lineHeight": 24, "weight": 600 },
    "body": { "size": 14, "lineHeight": 22, "weight": 400 },
    "bodySm": { "size": 13, "lineHeight": 20, "weight": 400 },
    "label": { "size": 12, "lineHeight": 18, "weight": 500 },
    "caption": { "size": 11, "lineHeight": 16, "weight": 400 }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 32,
    "8": 40,
    "9": 48,
    "10": 64
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "density": {
    "D1": { "label": "Spacious Commerce", "controlY": 12, "rowY": 16 },
    "D2": { "label": "Balanced Operations", "controlY": 10, "rowY": 12 },
    "D3": { "label": "Dense Command", "controlY": 8, "rowY": 10 }
  },
  "motion": {
    "micro": { "min": 120, "max": 160 },
    "standard": { "min": 160, "max": 240 },
    "overlay": { "min": 200, "max": 280 },
    "complexMax": 400
  }
