FROM node:22-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app/mvp

COPY mvp/package.json mvp/package-lock.json ./
COPY mvp/apps ./apps
COPY mvp/packages ./packages

RUN npm ci --workspace=@pol/web --include-workspace-root

ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

RUN npm run build --workspace=@pol/web
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0

WORKDIR /app/mvp

COPY --from=build /app/mvp/package.json ./package.json
COPY --from=build /app/mvp/package-lock.json ./package-lock.json
COPY --from=build /app/mvp/node_modules ./node_modules
COPY --from=build /app/mvp/apps/web ./apps/web
COPY --from=build /app/mvp/packages ./packages

EXPOSE 3001

CMD ["node", "apps/web/.next/standalone/apps/web/server.js"]
