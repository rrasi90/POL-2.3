FROM node:22-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app/mvp

COPY mvp/package.json mvp/package-lock.json ./
COPY mvp/apps ./apps
COPY mvp/packages ./packages
COPY logo ./logo

RUN npm ci --workspace=@pol/web --include-workspace-root

ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

RUN npm run build --workspace=@pol/web
RUN npm prune --omit=dev

# Next.js standalone does not copy static assets into the standalone tree.
# Promote them into the standalone runtime root so /_next/static/* resolves.
RUN mkdir -p apps/web/.next/standalone/.next/static \
    && cp -R apps/web/.next/static/. apps/web/.next/standalone/.next/static/

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0

WORKDIR /app/mvp/apps/web/.next/standalone

COPY --from=build /app/mvp/apps/web/.next/standalone ./
COPY --from=build /app/mvp/logo ./logo

EXPOSE 3001

CMD ["node", "apps/web/server.js"]
